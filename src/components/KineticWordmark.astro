---
import '@fontsource/anton/latin.css';
interface Props { lang?: 'sv' | 'en'; }
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
const letters = [...'adorable.'];
const widths = [1.02, .67, 1.36, .73, .83, .9, .47, .88, .32];
---
<div class="wordmark-stage" data-wordmark>
  <span class="wordmark-description" role="img" aria-label="Adorable"></span>
  <span class="static-type" aria-hidden="true">adorable.</span>
  <div class="kinetic-type" aria-hidden="true" hidden>
    {letters.map((letter, index) => <span class:list={['letter-slot', { accent: index === 2 }]} style={`--weight:${widths[index]};--slot-index:${index}`} data-weight={widths[index]}><span class="glyph">{letter}</span></span>)}
  </div>
  <button class="wordmark-toggle" type="button" hidden
    aria-label={en ? 'Pause the Adorable animation' : 'Pausa animationen av Adorable'}
    title={en ? 'Click to pause the animation' : 'Klicka för att pausa animationen'}
    data-pause-label={en ? 'Pause the Adorable animation' : 'Pausa animationen av Adorable'}
    data-play-label={en ? 'Resume the Adorable animation' : 'Starta animationen av Adorable'}
    data-pause-hint={en ? 'Click to pause the animation' : 'Klicka för att pausa animationen'}
    data-play-hint={en ? 'Click to resume the animation' : 'Klicka för att starta animationen'}></button>
</div>
<style>
  .wordmark-stage{position:relative;min-height:0;margin:clamp(16px,3svh,32px) -8px;container-type:size;isolation:isolate;overflow:hidden;background:var(--paper)}
  /* A single color field spans the whole word, rather than repeating per letter.
     Screen blending colors the black glyphs and leaves their white surround white. */
  .wordmark-stage::after{content:'';position:absolute;inset:-40%;pointer-events:none;mix-blend-mode:screen;background:radial-gradient(ellipse at 20% 25%,#8567e4 0%,transparent 48%),radial-gradient(ellipse at 82% 78%,#087f9a 0%,transparent 46%),linear-gradient(115deg,#2922a4 10%,#4d2fce 40%,#254af4 67%,#4423b6 100%);transform:translate3d(var(--gradient-x,0%),var(--gradient-y,0%),0);filter:hue-rotate(var(--gradient-hue,0deg))}
  .wordmark-description{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  .wordmark-toggle{position:absolute;inset:0;z-index:1;width:100%;height:100%;border:0;background:transparent;cursor:pointer}.wordmark-toggle:focus-visible{outline-offset:-6px}
  .wordmark-stage[data-paused='true'] .letter-slot{animation-play-state:paused}
  .static-type{display:flex;align-items:center;height:100%;white-space:nowrap;overflow:hidden;font-family:'Anton',sans-serif;font-size:min(29cqw,68cqh);line-height:1.48;letter-spacing:-.015em}
  .kinetic-type{display:flex;width:100%;height:100%;align-items:stretch;user-select:none;overflow:hidden}
  .letter-slot{position:relative;min-width:0;flex:var(--weight) 1 0%}
  .glyph{font-family:'Anton',sans-serif;font-weight:400;position:absolute;left:0;top:50%;font-size:116cqh;line-height:1;display:block;transform:translate(var(--letter-offset,0px),-55%) scaleX(var(--letter-scale,.65));transform-origin:left center;will-change:transform;color:var(--ink)}
  .accent .glyph{transform:translate(var(--letter-offset,0px),-55%) scale(var(--letter-scale,.65),1.1)}
  .letter-slot:last-child .glyph{font-family:'DM Sans',sans-serif;font-weight:700;font-size:65cqh;left:-.04em;top:auto;bottom:-.08em;transform:translateX(var(--letter-offset,0px)) scaleX(calc(var(--letter-scale,.65)*1.8));transform-origin:left bottom}
  @media(max-width:600px){.wordmark-stage{margin-inline:-4px}}
  @media(prefers-reduced-motion:reduce){.glyph{will-change:auto}}
  @media(forced-colors:active){.wordmark-stage::after{display:none}.wordmark-stage{background:Canvas}.glyph,.static-type{color:CanvasText}}
</style>
<script>
  const stage = document.querySelector<HTMLElement>('[data-wordmark]');
  if (stage) {
    const slots = [...stage.querySelectorAll<HTMLElement>('.letter-slot')];
    const glyphs = slots.map(slot => slot.querySelector<HTMLElement>('.glyph')!);
    const weights = slots.map(slot => Number(slot.dataset.weight));
    const baseSum = weights.reduce((a, b) => a + b, 0);
    const toggle = stage.querySelector<HTMLButtonElement>('.wordmark-toggle')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    // One clock drives a quiet ambient wave, a stronger pointer response and the
    // drifting color field. The wordmark itself is the accessible pause control.
    let ready = false;
    let paused = false;
    let elapsed = 0;
    let visible = true;
    let frame = 0;
    let previousTime: number | null = null;
    let hoverPosition: number | null = null;
    let currentPosition = 3.5;
    let currentStrength = 0;
    let widths: number[] = [];
    let stageWidth = 0;
    let drawn = [...weights];

    // Live font glyphs change width, never their reading order.
    function measure() {
      stageWidth = stage!.clientWidth;
      widths = glyphs.map(glyph => glyph.offsetWidth);
      draw(drawn);
    }
    function draw(values: number[]) {
      const sum = values.reduce((a, b) => a + b, 0);
      // Color keeps changing even when the pointer is stationary. Keep the hue
      // shift within the approved violet/blue/teal palette, never towards red.
      stage!.style.setProperty('--gradient-x', `${Math.sin(elapsed / 6500) * 12 + (currentPosition - 3.5) * currentStrength * 1.8}%`);
      stage!.style.setProperty('--gradient-y', `${Math.sin(elapsed / 8300) * 10}%`);
      stage!.style.setProperty('--gradient-hue', `${Math.sin(elapsed / 10500) * 16}deg`);
      let left = 0;
      let baseLeft = 0;
      values.forEach((weight, index) => {
        const width = stageWidth * weight / sum;
        // Keep layout slots fixed; only composite the glyph's position and scale.
        glyphs[index].style.setProperty('--letter-offset', `${left - baseLeft}px`);
        glyphs[index].style.setProperty('--letter-scale', String(Math.max(.02, (width - stageWidth * .006) / (widths[index] || 1))));
        left += width;
        baseLeft += stageWidth * weights[index] / baseSum;
      });
    }
    function tick(time: number) {
      frame = 0;
      // Limit ambient updates to about 30fps; pointer input uses the display rate.
      if (previousTime !== null && hoverPosition === null && time - previousTime < 1000 / 30) {
        frame = requestAnimationFrame(tick);
        return;
      }
      const delta = previousTime === null ? 0 : Math.min(time - previousTime, 64);
      previousTime = time;
      elapsed += delta;
      const interacting = hoverPosition !== null;
      const targetPosition = hoverPosition ?? 3.5 + Math.sin(elapsed / 3000) * 3.2;
      const targetStrength = interacting ? 1.05 : .14 + Math.sin(elapsed / 4400) * .025;
      currentPosition += (targetPosition - currentPosition) * (1 - Math.exp(-delta / (interacting ? 180 : 700)));
      currentStrength += (targetStrength - currentStrength) * (1 - Math.exp(-delta / (interacting ? 110 : 700)));
      drawn = weights.map((weight, index) => weight * (1 + currentStrength * Math.exp(-Math.pow(index - currentPosition, 2) / 1.1)));
      draw(drawn);
      frame = requestAnimationFrame(tick);
    }
    function sync() {
      cancelAnimationFrame(frame);
      frame = 0;
      previousTime = null;
      if (!ready) return;
      toggle.hidden = reduced.matches;
      if (reduced.matches) {
        hoverPosition = null;
        currentStrength = 0;
        currentPosition = 3.5;
        elapsed = 0;
        drawn = [...weights];
        draw(drawn);
      } else if (!visible || document.hidden) {
        hoverPosition = null;
      } else if (!paused) {
        frame = requestAnimationFrame(tick);
      }
    }
    stage.addEventListener('pointermove', event => {
      if (!pointer.matches || reduced.matches || paused) return;
      const rect = stage!.getBoundingClientRect();
      hoverPosition = Math.max(0, Math.min(8, (event.clientX - rect.left) / rect.width * 8));
    });
    stage.addEventListener('pointerleave', () => { hoverPosition = null; });
    toggle.addEventListener('click', () => {
      paused = !paused;
      hoverPosition = null;
      stage!.setAttribute('data-paused', String(paused));
      toggle.setAttribute('aria-label', paused ? toggle.dataset.playLabel! : toggle.dataset.pauseLabel!);
      toggle.title = paused ? toggle.dataset.playHint! : toggle.dataset.pauseHint!;
      sync();
    });
    reduced.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    window.addEventListener('pagehide', () => { cancelAnimationFrame(frame); frame = 0; previousTime = null; });
    window.addEventListener('pageshow', sync);
    new ResizeObserver(measure).observe(stage);
    new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); }).observe(stage);
    document.fonts.ready.then(() => {
      stage.querySelector<HTMLElement>('.static-type')!.hidden = true;
      stage.querySelector<HTMLElement>('.kinetic-type')!.hidden = false;
      ready = true;
      measure();
      sync();
    });
  }
</script>
