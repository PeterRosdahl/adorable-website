---
import Arrow from './Arrow.astro';
interface Props { lang?: 'sv' | 'en'; }
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
---
<div class="offer-pair">
  <a class="offer-card" href={en ? '/en/paid-social' : '/paid-social'}>
    <h2>Paid social</h2>
    <p>{en ? 'Strategy, campaigns and measurement on Meta and LinkedIn.' : 'Strategi, kampanjer och uppföljning på Meta och LinkedIn.'}</p>
    <Arrow direction="right" />
  </a>
  <a class="offer-card" href={en ? '/en/ai' : '/ai'}>
    <h2>{en ? 'AI consulting' : 'AI-rådgivning'}</h2>
    <p>{en ? 'Training, tools and automation that work in practice.' : 'Utbildning, verktyg och automatisering som fungerar i arbetet.'}</p>
    <Arrow direction="right" />
  </a>
</div>
