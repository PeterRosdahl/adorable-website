---
import Layout from '../layouts/Layout.astro';
import LayoutEn from '../layouts/Layout-en.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
  lang?: 'sv' | 'en';
  alternatePath: string;
}

const { title, description, updated, lang = 'sv', alternatePath } = Astro.props;
const Shell = lang === 'en' ? LayoutEn : Layout;
const layoutProps = lang === 'en'
  ? { title, description, robots: 'noindex, follow', swedishPath: alternatePath }
  : { title, description, robots: 'noindex, follow', englishPath: alternatePath };
---

<Shell {...layoutProps}>
  <main class="legal-page">
    <div class="container">
      <a class="back-link" href={lang === 'en' ? '/en' : '/'}>{lang === 'en' ? '← Back to Adorable' : '← Till Adorable'}</a>
      <h1>{title.replace(' | Adorable', '')}</h1>
      <p class="updated">{lang === 'en' ? 'Last updated' : 'Senast uppdaterad'}: {updated}</p>
      <slot />
    </div>
  </main>
</Shell>

<style>
  .legal-page {
    background: #fff;
    padding: 6rem 0;
  }

  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 3rem;
    color: #333;
    text-underline-offset: 0.18em;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .updated {
    color: #666;
    margin-bottom: 3rem;
  }

  :global(.legal-page h2) {
    font-size: 1.45rem;
    font-weight: 600;
    margin: 2.75rem 0 1rem;
  }

  :global(.legal-page p),
  :global(.legal-page li) {
    color: #333;
    font-size: 1rem;
    line-height: 1.75;
  }

  :global(.legal-page p) {
    margin-bottom: 1rem;
  }

  :global(.legal-page ul) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  :global(.legal-page a) {
    color: #000;
  }

  @media (max-width: 768px) {
    .legal-page {
      padding: 3rem 0;
    }
  }
</style>
