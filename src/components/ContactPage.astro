---
interface Props { lang?: 'sv' | 'en'; }
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
// Add the public Google Calendar appointment-schedule URL when Peter has created it.
const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL?.trim();
const validBookingUrl = bookingUrl && /^https:\/\/(calendar\.google\.com|calendar\.app\.google)\//.test(bookingUrl) ? bookingUrl : null;
---
<main class="studio-page contact-page">
  <div class="wrap contact-layout">
    <section class="contact-intro">
      <p class="eyebrow">{en ? 'Contact & meetings' : 'Kontakt & möte'}</p>
      <h1>{en ? 'Let’s talk.' : 'Vi börjar med\nett samtal.'}</h1>
      <p class="contact-lead">{en ? 'Tell me what you need help with. We’ll discuss your situation and whether I’m the right person to help.' : 'Berätta vad ni behöver hjälp med. Vi går igenom er situation och om jag är rätt person att hjälpa till.'}</p>
      <p class="contact-person">Peter Rosdahl<span>{en ? 'Founder & senior consultant' : 'Grundare & seniorkonsult'}</span></p>
      <a class="direct-link" href="mailto:peter@adorable.se" data-umami-event="contact-email-click">peter@adorable.se <span aria-hidden="true">↗</span></a>
      <a class="direct-link phone" href="tel:+46708235787" data-umami-event="contact-phone-click">+46 70 823 57 87 <span aria-hidden="true">↗</span></a>
      <p class="reply-note">{en ? 'I usually reply within a couple of hours.' : 'Jag svarar oftast inom ett par timmar.'}</p>
      <div class="meeting-explained"><p class="eyebrow">{en ? 'A first conversation' : 'Ett första samtal'}</p><p>{en ? 'We discuss what you want to achieve, what you have tried and how I could help. No preparation needed.' : 'Vi pratar om vad ni vill uppnå, vad ni har testat och hur jag skulle kunna hjälpa till. Ni behöver inte förbereda något.'}</p><p>{en ? 'No cost or obligation. Online or in Stockholm.' : 'Kostnadsfritt och utan förbindelse. Digitalt eller i Stockholm.'}</p></div>
    </section>
    <section class="contact-panel" aria-labelledby="form-heading">
      {validBookingUrl && <div class="calendar-booking"><h2>{en ? 'Choose a time.' : 'Välj en tid.'}</h2><p>{en ? 'See available times in my Google Calendar booking page.' : 'Se lediga tider och boka direkt i min Google Kalender.'}</p><a class="action" href={validBookingUrl} target="_blank" rel="noopener noreferrer" data-umami-event="booking-calendar-click">{en ? 'Open booking calendar' : 'Öppna bokningskalendern'} <span aria-hidden="true">↗</span></a></div>}
      <div id="contact-success" class="form-success" role="status" tabindex="-1" hidden></div>
      <h2 id="form-heading">{validBookingUrl ? (en ? 'Or send a message.' : 'Eller skicka ett meddelande.') : (en ? 'What would you like to do?' : 'Vad vill du göra?')}</h2>
      <form class="contact-form" action="https://api.web3forms.com/submit" method="POST" data-lang={lang}>
        <input type="hidden" name="access_key" value="658f2386-7125-4653-b0ac-5d725aeab234" />
        <input type="hidden" name="subject" value="Ny förfrågan från adorable.se" />
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <fieldset class="intent-options"><legend class="sr-only">{en ? 'Type of enquiry' : 'Typ av förfrågan'}</legend><label><input type="radio" name="request_type" value="meeting" checked={!validBookingUrl} /><span>{en ? 'Arrange a meeting' : 'Boka ett möte'}</span></label><label><input type="radio" name="request_type" value="question" checked={!!validBookingUrl} /><span>{en ? 'Ask a question' : 'Ställ en fråga'}</span></label></fieldset>
        <p class="form-note" data-meeting-copy>{en ? 'A first conversation is free, with no obligation. Send a request and I’ll get back to you. The meeting is confirmed once we have agreed a time.' : 'Ett första samtal är kostnadsfritt och utan förbindelse. Skicka en förfrågan så återkommer jag. Mötet är bokat först när vi har bekräftat tiden tillsammans.'}</p>
        <div class="form-row"><div class="form-field"><label for="contact-name">{en ? 'Name' : 'Namn'}</label><input id="contact-name" name="name" autocomplete="name" maxlength="120" required /></div><div class="form-field"><label for="contact-email">{en ? 'Email' : 'E-post'}</label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div></div>
        <div class="form-field"><label for="contact-interest">{en ? 'What do you need help with?' : 'Vad behöver ni hjälp med?'} <span>{en ? '(optional)' : '(valfritt)'}</span></label><select id="contact-interest" name="interest"><option value="unsure">{en ? 'Let’s work it out together' : 'Det tar vi reda på tillsammans'}</option><option value="paid-social">Paid social</option><option value="ai">{en ? 'AI consulting' : 'AI-rådgivning'}</option><option value="both">{en ? 'Both' : 'Både och'}</option></select></div>
        <div class="form-field" data-meeting-field><label for="contact-time">{en ? 'When suits you?' : 'När passar det?'} <span>{en ? '(optional)' : '(valfritt)'}</span></label><input id="contact-time" name="preferred_time" maxlength="250" placeholder={en ? 'E.g. Tuesday afternoon, online' : 'T.ex. tisdag eftermiddag, digitalt'} /><small>{en ? 'Suggest a time or leave this blank and I’ll send options.' : 'Föreslå en tid eller lämna tomt så skickar jag förslag.'}</small></div>
        <div class="form-field"><label for="contact-message">{en ? 'A few words about your situation' : 'Några ord om er situation'} <span>{en ? '(optional)' : '(valfritt)'}</span></label><textarea id="contact-message" name="message" rows="4" maxlength="5000" placeholder={en ? 'Company, challenge or something you want to discuss…' : 'Företag, utmaning eller något du vill prata om…'}></textarea></div>
        <div class="form-error" role="alert" tabindex="-1" hidden></div>
        <button class="action form-submit" type="submit"><span data-submit-label>{en ? 'Send enquiry' : 'Skicka förfrågan'}</span><span class="arrow" aria-hidden="true">↗</span></button>
        <p class="form-privacy">{en ? 'I use your details to respond to your enquiry. The form is sent via Web3Forms.' : 'Jag använder dina uppgifter för att svara på förfrågan. Formuläret skickas via Web3Forms.'} <a href={en ? '/en/privacy' : '/privacy'}>{en ? 'Privacy policy' : 'Integritetspolicy'}</a>.</p>
      </form>
    </section>
  </div>
</main>
<style>
  .contact-layout{display:grid;grid-template-columns:1fr 1.05fr;gap:clamp(40px,7vw,110px);padding-block:70px 100px;align-items:start}.contact-intro .eyebrow{margin-bottom:26px}.contact-intro h1{font-size:clamp(3rem,5.8vw,5.8rem);line-height:1.04;white-space:pre-line;margin-bottom:26px;max-width:12ch}.contact-lead{max-width:38ch;font-size:1.13rem;color:var(--muted)}.contact-person{font-size:1.2rem;font-weight:500;margin-top:38px}.contact-person span{display:block;font-size:.85rem;font-weight:400;color:var(--muted);margin-top:4px}.direct-link{font-size:clamp(1.2rem,2.4vw,2rem);text-decoration:none;display:flex;gap:20px;align-items:center;min-height:48px;margin-top:18px;letter-spacing:-.03em}.direct-link:hover{text-decoration:underline}.direct-link.phone{font-size:1.08rem;letter-spacing:0;margin-top:0}.reply-note{font-size:.85rem;color:var(--muted);margin-top:10px}.meeting-explained{margin-top:44px;padding-top:24px;border-top:1px solid var(--line);max-width:42ch}.meeting-explained .eyebrow{margin-bottom:14px}.meeting-explained p:not(.eyebrow){font-size:.93rem;color:var(--muted);margin-bottom:14px}
  .contact-panel{background:#fff;padding:clamp(24px,3.5vw,46px);border-radius:4px}.contact-panel h2{font-size:1.7rem;margin-bottom:25px}.calendar-booking{padding-bottom:32px;margin-bottom:32px;border-bottom:1px solid var(--line)}.calendar-booking p{color:var(--muted);margin-bottom:20px}.intent-options{border:0;display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px}.intent-options label{position:relative;cursor:pointer}.intent-options input{position:absolute;opacity:0;width:1px;height:1px}.intent-options span{display:block;border:1px solid var(--line);border-radius:3px;text-align:center;padding:13px 8px;font-size:.9rem}.intent-options input:checked+span{background:var(--ink);color:#fff;border-color:var(--ink)}.intent-options input:focus-visible+span{outline:3px solid #516a13;outline-offset:4px}.form-note{font-size:.83rem;color:var(--muted);margin-bottom:24px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}.form-field{margin-bottom:20px}.form-field label{display:block;font-size:.85rem;font-weight:500;margin-bottom:8px}.form-field label span{font-weight:400;color:var(--muted)}.form-field input,.form-field select,.form-field textarea{width:100%;min-width:0;padding:13px 14px;border:1px solid #bfc4b8;border-radius:3px;background:#fff;color:var(--ink);font-size:1rem;min-height:48px}.form-field textarea{resize:vertical;min-height:110px}.form-field input::placeholder,.form-field textarea::placeholder{color:#73796c;font-size:.88rem}.form-field small{display:block;color:var(--muted);font-size:.75rem;margin-top:8px}.form-submit{width:100%;margin-top:6px}.form-submit:disabled{opacity:.65;cursor:wait;transform:none}.form-privacy{font-size:.73rem;color:var(--muted);margin-top:18px;line-height:1.65}.form-success{padding:22px;background:#edf5dd;border:1px solid #9faf87;line-height:1.65;margin-bottom:24px}.form-error{padding:16px;background:#fff0eb;border:1px solid #b96040;color:#742f19;margin-bottom:20px;line-height:1.6;font-size:.9rem}.botcheck{display:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:800px){.contact-layout{grid-template-columns:1fr;gap:36px;padding-block:44px 60px}.contact-intro h1{max-width:14ch}.meeting-explained{display:none}.contact-person{margin-top:26px}.contact-panel{padding:26px 22px}.form-row{grid-template-columns:1fr;gap:0}}
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  if (form) {
    const en = form.dataset.lang === 'en';
    const submit = form.querySelector<HTMLButtonElement>('.form-submit')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const error = form.querySelector<HTMLElement>('.form-error')!;
    const success = document.querySelector<HTMLElement>('#contact-success')!;
    const meetingField = form.querySelector<HTMLElement>('[data-meeting-field]')!;
    const meetingCopy = form.querySelector<HTMLElement>('[data-meeting-copy]')!;
    const time = form.querySelector<HTMLInputElement>('#contact-time')!;
    const isMeeting = () => form.querySelector<HTMLInputElement>('[name="request_type"]:checked')?.value === 'meeting';
    const updateIntent = () => {
      const meeting = isMeeting();
      meetingField.hidden = !meeting;
      time.disabled = !meeting;
      meetingCopy.hidden = !meeting;
      submitLabel.textContent = meeting ? (en ? 'Send meeting request' : 'Skicka mötesförfrågan') : (en ? 'Send message' : 'Skicka meddelande');
    };
    const interest = new URLSearchParams(window.location.search).get('interest');
    if (interest && ['paid-social','ai','both'].includes(interest)) form.querySelector<HTMLSelectElement>('#contact-interest')!.value = interest;
    form.querySelectorAll('[name="request_type"]').forEach(radio => radio.addEventListener('change', updateIntent));
    updateIntent();
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (submit.disabled || !form.reportValidity()) return;
      error.hidden = true;
      success.hidden = true;
      const meeting = isMeeting();
      const data = new FormData(form);
      if (data.get('botcheck')) return;
      data.set('subject', meeting ? 'Mötesförfrågan från adorable.se' : 'Meddelande från adorable.se');
      if (!String(data.get('message') || '').trim()) data.set('message', meeting ? 'Önskar boka ett första möte.' : 'Önskar bli kontaktad.');
      submit.disabled = true;
      form.setAttribute('aria-busy','true');
      submitLabel.textContent = en ? 'Sending…' : 'Skickar…';
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 20000);
      try {
        const response = await fetch(form.action, { method:'POST', body:data, headers:{Accept:'application/json'}, signal:controller.signal });
        const result = await response.json();
        if (!response.ok || result.success !== true) throw new Error('Not accepted');
        success.textContent = meeting
          ? (en ? 'Thank you! Your meeting request has been sent. I’ll get back to you to agree a time. No appointment is booked yet.' : 'Tack! Din mötesförfrågan är skickad. Jag återkommer med en tid. Ingen tid är bokad ännu.')
          : (en ? 'Thank you! Your message has been sent. I usually reply within a couple of hours.' : 'Tack! Ditt meddelande är skickat. Jag svarar oftast inom ett par timmar.');
        success.hidden = false;
        form.reset();
        success.focus();
        // Analytics must never change an already-confirmed delivery state.
        try {
          const analytics = (window as Window & { umami?: { track: (event:string)=>void } }).umami;
          analytics?.track(meeting ? 'meeting-request-success' : 'contact-form-success');
        } catch { /* Contact delivery does not depend on analytics. */ }
      } catch {
        error.textContent = en ? 'We couldn’t confirm that your enquiry arrived. Your text is still here. Please email peter@adorable.se or call +46 70 823 57 87 before sending it again.' : 'Det gick inte att bekräfta att förfrågan kom fram. Din text finns kvar. Mejla peter@adorable.se eller ring 070 823 57 87 innan du skickar igen.';
        error.hidden = false;
        error.focus();
      } finally {
        window.clearTimeout(timeout);
        submit.disabled = false;
        form.removeAttribute('aria-busy');
        updateIntent();
      }
    });
  }
</script>
