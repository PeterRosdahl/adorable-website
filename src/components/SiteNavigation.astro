---
import Arrow from './Arrow.astro';
interface Props { lang?: 'sv' | 'en'; alternatePath?: string; }
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
const home = en ? '/en' : '/';
const contact = en ? '/en/contact' : '/kontakt';
---
<header class="site-header">
  <nav class="wrap site-nav" aria-label={en ? 'Main navigation' : 'Huvudmeny'}>
    <a class="wordmark" href={home} aria-label={en ? 'Adorable home' : 'Adorable startsida'}>Adorable.</a>
    <a class="nav-about" href={contact}>{en ? 'Contact' : 'Kontakt'}</a>
    <a class="nav-contact" href={contact} data-umami-event="contact-nav-click">{en ? 'Arrange a meeting' : 'Boka ett möte'}<Arrow /></a>
  </nav>
</header>
<style>
  .site-header{position:relative;z-index:20;background:var(--paper)}
  .site-nav{min-height:92px;display:flex;align-items:center;gap:54px}
  .wordmark{font-family:'Adorable Wordmark','DM Sans',sans-serif;font-size:1.7rem;letter-spacing:-.085em;text-decoration:none;margin-right:auto;line-height:1;min-height:44px;display:flex;align-items:center}
  .nav-about{font-size:.95rem;text-decoration:none;min-height:44px;display:flex;align-items:center}.nav-about:hover{text-decoration:underline}
  .nav-contact{display:flex;align-items:center;gap:20px;text-decoration:none;color:var(--accent);border-bottom:1px solid currentColor;font-size:1.1rem;min-height:44px;white-space:nowrap;transition:color .3s}.nav-contact:hover{color:var(--ink)}
  @media(max-width:760px){.site-nav{min-height:76px;gap:24px}.wordmark{font-size:1.35rem}.nav-contact{font-size:.9rem;gap:12px}.nav-about{display:none}}
</style>
