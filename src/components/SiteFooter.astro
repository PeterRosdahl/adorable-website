---
import Arrow from './Arrow.astro';
interface Props { lang?: 'sv' | 'en'; }
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
const contact = en ? '/en/contact' : '/kontakt';
const isContact = Astro.url.pathname.replace(/\/$/, '') === contact;
---
<footer class="site-footer">
  <div class="wrap">
    {!isContact && <a class="footer-invite" href={contact} data-umami-event="contact-footer-click">{en ? 'Let’s talk.' : 'Ska vi prata?'}<Arrow /></a>}
    <div class="footer-columns">
      <div class="footer-person"><p>Peter Rosdahl</p><a href="mailto:peter@adorable.se" data-umami-event="contact-email-click">peter@adorable.se</a><a href="tel:+46708235787" data-umami-event="contact-phone-click">+46 70 823 57 87</a><span>{en ? 'Usually replies within a couple of hours.' : 'Svarar oftast inom ett par timmar.'}</span></div>
      <div class="footer-links"><a href={en ? '/en/paid-social' : '/paid-social'}>Paid social</a><a href={en ? '/en/ai' : '/ai'}>{en ? 'AI consulting' : 'AI-rådgivning'}</a><a href={en ? '/en/about' : '/om'}>{en ? 'About Peter' : 'Om Peter'}</a><a href="https://www.linkedin.com/in/peterrosdahl" target="_blank" rel="noopener noreferrer">LinkedIn<Arrow /></a></div>
    </div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} Adorable</span><div><a href={en ? '/en/privacy' : '/privacy'}>{en ? 'Privacy policy' : 'Integritetspolicy'}</a><a href={en ? '/en/terms' : '/tos'}>{en ? 'Terms' : 'Villkor'}</a><a href={en ? '/' : '/en'} lang={en ? 'sv' : 'en'}>{en ? 'Svenska' : 'English'}</a></div></div>
  </div>
</footer>
<style>
  .site-footer{background:var(--ink);color:white;padding:50px 0 20px}
  .footer-invite{display:flex;justify-content:space-between;align-items:center;font-size:clamp(3rem,9vw,10rem);letter-spacing:-.065em;line-height:1.1;text-decoration:none;padding-block:20px 64px;border-bottom:1px solid #444}
  .footer-invite .icon-arrow{font-size:.7em}.footer-invite:hover{color:#b5beff}
  .footer-columns{display:grid;grid-template-columns:1fr 1fr;gap:48px;padding-block:48px}
  .footer-person p{font-size:1.15rem;margin-bottom:15px}.footer-person>a{display:block;text-decoration:none;min-height:36px;font-size:clamp(1rem,1.6vw,1.5rem)}
  .footer-person>a:hover{text-decoration:underline}.footer-person>span{display:block;font-size:.85rem;color:#bdbdbd;margin-top:16px}
  .footer-links{display:flex;flex-direction:column;align-items:flex-start;justify-self:end;min-width:30%}.footer-links a{display:inline-flex;gap:12px;align-items:center;min-height:38px;text-decoration:none}.footer-links a:hover{text-decoration:underline}
  .footer-bottom{border-top:1px solid #444;padding-top:20px;display:flex;justify-content:space-between;gap:20px;font-size:.75rem;color:#bdbdbd}.footer-bottom>div{display:flex;flex-wrap:wrap;gap:10px 24px}.footer-bottom a{text-decoration:none;min-height:34px;display:inline-flex;align-items:center}.footer-bottom a:hover{text-decoration:underline}
  .site-footer :focus-visible{outline-color:white}
  @media(max-width:600px){.site-footer{padding-top:24px}.footer-invite{padding-bottom:34px}.footer-columns{grid-template-columns:1fr;gap:28px}.footer-links{justify-self:start}.footer-bottom{flex-direction:column}}
</style>
