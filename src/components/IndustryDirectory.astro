---
import Arrow from './Arrow.astro';
import { industries } from '../content/industries';
import { industryHref, localizeIndustry, type Lang } from '../i18n/catalog';
interface Props { lang?: Lang; }
const { lang = 'sv' } = Astro.props;
---
<div class="industry-directory">{industries.map(page => { const copy = localizeIndustry(page.slug, lang); return <a href={industryHref(page.slug, lang)}><h2>{copy.name}</h2><p>{copy.intro}</p><Arrow direction="right" /></a>; })}</div>
<style>
  .industry-directory{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:48px}.industry-directory a{display:grid;grid-template-columns:1fr auto;gap:20px;text-decoration:none;border-top:1px solid var(--line);padding-top:28px}.industry-directory h2{font-size:clamp(1.6rem,2.5vw,2.5rem)}.industry-directory p{grid-column:1;max-width:52ch;color:var(--muted)}.industry-directory :global(.icon-arrow){grid-column:2;grid-row:1;color:var(--accent)}.industry-directory a:hover h2{color:var(--accent)}
  @media(max-width:650px){.industry-directory{grid-template-columns:1fr}}
</style>
