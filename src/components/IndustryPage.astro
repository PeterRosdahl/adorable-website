---
import Layout from '../layouts/Layout.astro';
import MotionTitle from './MotionTitle.astro';
import Arrow from './Arrow.astro';
import { industries } from '../content/industries';
import { findServicePage } from '../content/service-pages';
interface Props { slug: string; }
const page = industries.find(item => item.slug === Astro.props.slug)!;
---
<Layout title={page.title} description={page.description}>
  <main class="studio-page industry-page">
    <section class="page-hero wrap">
      <a class="text-link industry-back" href="/branscher">Alla branscher <Arrow direction="right" /></a>
      <MotionTitle text={page.name} />
      <p class="lead">{page.intro}</p>
      <div class="actions"><a class="action" href={`/kontakt?industry=${page.slug}`}>Prata om ert behov <Arrow /></a></div>
      <p class="subnote">Direkt med Peter Rosdahl. Första samtalet är kostnadsfritt.</p>
    </section>
    <section class="section-space wrap quiet-band editorial-grid"><div><h2>Utgå från ert arbete.</h2></div><div class="editorial-copy"><p>{page.focus}</p></div></section>
    <section class="section-space wrap"><div class="section-top"><h2>Det här kan jag hjälpa till med.</h2></div><div class="deliverables">{page.items.map(([title, text], index) => <div class="deliverable"><span class="number">0{index + 1}</span><h3>{title}</h3><p>{text}</p></div>)}</div></section>
    <section class="section-space wrap editorial-grid quiet-band"><div><h2>Tydligt ansvar från början.</h2></div><div class="editorial-copy"><p>{page.boundary}</p><p>Vi bestämmer omfattning, ansvar, leveranser, tidsplan och kostnad innan arbetet börjar. Exemplen beskriver möjliga upplägg, inte genomförda kundcase.</p><a class="text-link" href="/om">Om Peter <Arrow /></a></div></section>
    <section id="faq" class="section-space wrap editorial-grid"><div><h2>Vanliga frågor.</h2></div><div class="question-list">{page.faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
    <section class="section-space wrap quiet-band"><div class="section-top"><h2>Se tjänsterna.</h2></div><div class="industry-related">{page.related.map(slug => <a class="text-link" href={`/${slug}`}>{findServicePage(slug)!.name} <Arrow /></a>)}</div></section>
  </main>
</Layout>
<style>
  .industry-back{margin-bottom:28px;font-size:.9rem}
  .industry-page :global(.motion-title){font-size:clamp(2.25rem,6.5vw,6.5rem)}
  .editorial-grid h2{font-size:clamp(2rem,3.5vw,3.5rem);max-width:20ch}.industry-related{display:flex;flex-wrap:wrap;gap:24px 48px}
</style>
