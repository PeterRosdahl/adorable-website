---
import Layout from '../layouts/Layout.astro';
import LayoutEn from '../layouts/Layout-en.astro';
import MotionTitle from './MotionTitle.astro';
import Arrow from './Arrow.astro';
import { industriesIndex, localizeIndustry, localizeService, serviceHref, type Lang } from '../i18n/catalog';
interface Props { slug: string; lang?: Lang; }
const { slug, lang = 'sv' } = Astro.props;
const en = lang === 'en';
const page = localizeIndustry(slug, lang);
const Shell = en ? LayoutEn : Layout;
const layoutProps = { title: page.title, description: page.description };
---
<Shell {...layoutProps}>
  <main class="studio-page industry-page">
    <section class="page-hero wrap">
      <a class="text-link industry-back" href={industriesIndex(lang)}>{en ? 'All industries' : 'Alla branscher'} <Arrow direction="right" /></a>
      <MotionTitle text={page.name} />
      <p class="lead">{page.intro}</p>
      <div class="actions"><a class="action" href={`${en ? '/en/contact' : '/kontakt'}?industry=${slug}`}>{en ? 'Discuss your needs' : 'Prata om ert behov'} <Arrow /></a></div>
      <p class="subnote">{en ? 'Directly with Peter Rosdahl. No cost or obligation for the first conversation.' : 'Direkt med Peter Rosdahl. Första samtalet är kostnadsfritt.'}</p>
    </section>
    <section class="section-space wrap quiet-band editorial-grid"><div><h2>{en ? 'Start from your work.' : 'Utgå från ert arbete.'}</h2></div><div class="editorial-copy"><p>{page.focus}</p></div></section>
    <section class="section-space wrap"><div class="section-top"><h2>{en ? 'What I can help with.' : 'Det här kan jag hjälpa till med.'}</h2></div><div class="deliverables">{page.items.map(([title, text], index) => <div class="deliverable"><span class="number">0{index + 1}</span><h3>{title}</h3><p>{text}</p></div>)}</div></section>
    <section class="section-space wrap editorial-grid quiet-band"><div><h2>{en ? 'Clear responsibility from the start.' : 'Tydligt ansvar från början.'}</h2></div><div class="editorial-copy"><p>{page.boundary}</p><p>{en ? 'We agree scope, responsibilities, deliverables, timeline and cost before the work starts. The examples describe possible engagements, not completed client cases.' : 'Vi bestämmer omfattning, ansvar, leveranser, tidsplan och kostnad innan arbetet börjar. Exemplen beskriver möjliga upplägg, inte genomförda kundcase.'}</p><a class="text-link" href={en ? '/en/about' : '/om'}>{en ? 'About Peter' : 'Om Peter'} <Arrow /></a></div></section>
    <section id="faq" class="section-space wrap editorial-grid"><div><h2>{en ? 'Common questions.' : 'Vanliga frågor.'}</h2></div><div class="question-list">{page.faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
    <section class="section-space wrap quiet-band"><div class="section-top"><h2>{en ? 'See the services.' : 'Se tjänsterna.'}</h2></div><div class="industry-related">{page.related.map(related => <a class="text-link" href={serviceHref(related, lang)}>{localizeService(related, lang).name} <Arrow /></a>)}</div></section>
  </main>
</Shell>
<style>
  .industry-back{margin-bottom:28px;font-size:.9rem}
  .industry-page :global(.motion-title){font-size:clamp(2.25rem,6.5vw,6.5rem)}
  .editorial-grid h2{font-size:clamp(2rem,3.5vw,3.5rem);max-width:20ch}.industry-related{display:flex;flex-wrap:wrap;gap:24px 48px}
</style>
