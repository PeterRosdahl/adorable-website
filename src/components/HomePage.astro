---
import OfferPair from './OfferPair.astro';
import KineticWordmark from './KineticWordmark.astro';
import Arrow from './Arrow.astro';
interface Props { lang?: 'sv' | 'en'; }
const { lang = 'sv' } = Astro.props;
const en = lang === 'en';
const contact = en ? '/en/contact' : '/kontakt';
---
<main class="studio-page">
  <section class="home-hero wrap">
    <div class="home-intro">
      <h1>{en ? 'Paid social and AI consulting.' : 'Paid social och AI-rådgivning.'}</h1>
      <p>{en ? 'I help companies with advertising and practical uses of AI.' : 'Jag hjälper företag med annonsering och praktisk användning av AI.'}</p>
    </div>
    <KineticWordmark lang={lang} />
    <div class="hero-contact">
      <a class="meeting-link" href={contact} data-umami-event="contact-hero-click">{en ? 'Arrange a meeting' : 'Boka ett möte'}<Arrow /></a>
      <a class="email-link" href="mailto:peter@adorable.se" data-umami-event="contact-email-click">peter@adorable.se</a>
      <a class="hero-scroll" href="#services">{en ? 'Scroll to explore' : 'Scrolla vidare'}<Arrow direction="down" /></a>
    </div>
  </section>
  <section id="services" class="wrap home-services" tabindex="-1" aria-label={en ? 'Services' : 'Tjänster'}><OfferPair lang={lang} /></section>
  <section class="home-about section-space wrap">
    <h2>Peter Rosdahl.</h2>
    <div><p>{en ? 'I’m the person you work with. I have 20 years of experience in digital marketing, development and business development. I founded Adorable in 2016.' : 'Det är mig ni jobbar med. Jag har 20 års erfarenhet av digital marknadsföring, utveckling och affärsutveckling. Adorable startade jag 2016.'}</p><p>{en ? 'I advise, do the work and follow up. For a specific project or as part of your team over time.' : 'Jag ger råd, gör jobbet och följer upp. I ett avgränsat projekt eller som en del av ert team över tid.'}</p><a class="text-link" href={en ? '/en/about' : '/om'}>{en ? 'More about Peter' : 'Mer om Peter'}<Arrow /></a></div>
  </section>
</main>
