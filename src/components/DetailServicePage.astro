---
import MotionTitle from './MotionTitle.astro';
import Arrow from './Arrow.astro';
import { isAIPage } from '../content/service-pages';
import { industriesIndex, localizeService, serviceHref, type Lang } from '../i18n/catalog';
interface Props { svSlug: string; lang?: Lang; }
const { svSlug, lang = 'sv' } = Astro.props;
const en = lang === 'en';
const page = localizeService(svSlug, lang);
const ai = isAIPage(svSlug);
const parent = en
  ? (ai ? ['/en/ai', 'AI consulting'] : ['/en/services', 'All services'])
  : (ai ? ['/ai', 'AI-rådgivning'] : ['/tjanster', 'Alla tjänster']);
const contact = `${en ? '/en/contact' : '/kontakt'}?interest=${svSlug}`;
---
<main class="studio-page detail-page">
  <section class:list={['page-hero', ai ? 'green' : 'dark']}>
    <div class="wrap">
      <a class="back-link" href={parent[0]}>{parent[1]} <Arrow direction="right" /></a>
      <MotionTitle text={page.name} />
      <p class="lead">{page.intro}</p>
      <div class="actions"><a class="action" href={contact} data-umami-event={`contact-${svSlug}-click`}>{en ? 'Discuss your needs' : 'Prata om ert behov'} <Arrow /></a><a class="text-link" href="#deliverables">{en ? 'See how I help' : 'Se vad ni får hjälp med'} <Arrow direction="down" /></a></div>
      <p class="subnote">{en ? 'Directly with Peter Rosdahl. No cost or obligation for the first conversation.' : 'Direkt med Peter Rosdahl. Första samtalet är kostnadsfritt.'}</p>
    </div>
  </section>
  <section class="section-space wrap editorial-grid">
    <div><h2>{en ? 'When it fits.' : 'När det passar.'}</h2></div>
    <div class="editorial-copy"><p>{page.fit}</p><p>{page.focus}</p></div>
  </section>
  <section id="deliverables" class="wrap section-space quiet-band">
    <div class="section-top"><h2>{en ? 'What I help you with.' : 'Det här hjälper jag er med.'}</h2></div>
    <div class="deliverables">{page.items.map(([title, text], i) => <div class="deliverable"><span class="number">0{i + 1}</span><h3>{title}</h3><p>{text}</p></div>)}</div>
  </section>
  <section class="section-space wrap editorial-grid">
    <div><h2>{page.startingPoint[0]}</h2></div>
    <div class="editorial-copy"><p>{page.startingPoint[1]}</p><h3>{en ? 'What I need from you' : 'Det vi behöver från er'}</h3><p>{page.preparation}</p><p>{en ? 'You get a proposal with scope, responsibilities, deliverables, timeline and cost before we start.' : 'Ni får ett förslag med omfattning, ansvar, leveranser, tidsplan och kostnad innan vi börjar.'}</p><a class="text-link" href={en ? '/en/about' : '/om'}>{en ? 'About Peter and the way of working' : 'Om Peter och arbetssättet'} <Arrow /></a></div>
  </section>
  <section id="faq" class="section-space wrap editorial-grid quiet-band">
    <div><h2>{en ? 'Common questions.' : 'Vanliga frågor.'}</h2></div>
    <div class="question-list">{page.faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
  </section>
  <section class="section-space wrap">
    <div class="section-top"><h2>{ai ? (en ? 'More help with AI.' : 'Mer hjälp med AI.') : (en ? 'More ways to advertise.' : 'Fler sätt att annonsera.')}</h2></div>
    <div class="related-services">{page.related.map(slug => { const related = localizeService(slug, lang); return <a class="text-link" href={serviceHref(slug, lang)}>{related.name} <Arrow /></a>; })}{!ai && <a class="text-link" href={en ? '/en/paid-social' : '/paid-social'}>{en ? 'All about paid social' : 'Allt om paid social'} <Arrow /></a>}<a class="text-link" href={industriesIndex(lang)}>{en ? 'Examples by industry' : 'Exempel per bransch'} <Arrow /></a></div>
  </section>
</main>
<style>
  .back-link{display:inline-flex;align-items:center;gap:14px;min-height:44px;margin-bottom:28px;font-size:.9rem;text-decoration:none;color:inherit}.back-link:hover{text-decoration:underline}
  .detail-page :global(.motion-title){font-size:clamp(2.25rem,6.5vw,6.5rem);max-width:22ch}
  .editorial-grid h2{font-size:clamp(2rem,3.5vw,3.5rem);max-width:20ch}.editorial-copy h3{font-size:1.2rem;letter-spacing:-.03em;margin-bottom:12px}
  .related-services{display:flex;flex-wrap:wrap;gap:24px 48px}
  .page-hero :global(:focus-visible){outline-color:white}
</style>
