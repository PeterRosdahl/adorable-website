<Layout title="Insikter & guider om paid social och AI | Adorable" description="Praktiska guider från Peter Rosdahl om annonsering, AI och mätning. För dig som vill förstå, välja och komma vidare i arbetet.">
  <main class="studio-page">
    <section class="page-hero wrap">
      <p class="eyebrow">Av Peter Rosdahl</p>
      <h1>Insikter & guider.</h1>
      <p class="lead">Om annonsering, AI och mätning. För dig som vill förstå, välja och komma vidare i arbetet.</p>
      <nav class="topic-nav" aria-label="Välj ämne">
        {categories.map(category => <a href={`#${category.id}`}>{category.label}<span aria-hidden="true">↓</span></a>)}
      </nav>
    </section>
    {categories.map(category => <section class="guide-section wrap" id={category.id} aria-labelledby={`heading-${category.id}`}>
      <div class="section-top"><h2 id={`heading-${category.id}`}>{category.label}</h2><p>{articles.filter(article => article.category === category.name).length} guider</p></div>
      <div class="guide-grid">
        {articles.filter(article => article.category === category.name).map(article => <article class="guide-item">
          <p class="guide-date">Uppdaterad {article.updated}</p>
          <h3><a href={`/artiklar/${article.slug}`}>{article.title}<span aria-hidden="true">↗</span></a></h3>
          <p class="guide-excerpt">{article.excerpt}</p>
        </article>)}
      </div>
    </section>)}
  </main>
</Layout>

<style>
  .topic-nav{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}.topic-nav a{display:flex;align-items:center;gap:24px;border:1px solid var(--line);border-radius:3px;padding:12px 18px;min-height:48px;text-decoration:none;font-size:.9rem}.topic-nav a:hover{background:var(--acid)}
  .guide-section{padding-bottom:80px;scroll-margin-top:30px}.guide-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 64px}.guide-item{border-top:1px solid var(--line);padding-block:26px 36px}.guide-date{font-size:.75rem;color:var(--muted);margin-bottom:16px}.guide-item h3{font-size:clamp(1.35rem,2.3vw,2rem);margin-bottom:18px}.guide-item h3 a{display:flex;gap:24px;justify-content:space-between;text-decoration:none}.guide-item h3 a:hover{text-decoration:underline}.guide-item h3 span{font-size:1.1rem;line-height:1.6;flex-shrink:0}.guide-excerpt{font-size:.98rem;color:var(--muted);max-width:52ch}
  @media(max-width:760px){.guide-grid{grid-template-columns:1fr}.guide-section{padding-bottom:50px}.topic-nav{gap:8px}.topic-nav a{font-size:.85rem;gap:16px;padding:11px 14px}}
</style>
