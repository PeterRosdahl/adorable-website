---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
---
<Layout title="Sidan hittades inte | Adorable" description="Sidan finns inte längre. Se Adorables tjänster eller kontakta Peter." robots="noindex, follow">
  <main class="studio-page">
    <section class="page-hero wrap">
      <h1>Sidan finns inte.</h1>
      <p class="lead">Den kan ha flyttats eller tagits bort. Här hittar du Adorables tjänster och kontaktuppgifter.</p>
      <div class="actions"><a class="action" href="/">Till startsidan<Arrow /></a><a class="text-link" href="/kontakt">Kontakta Peter<Arrow /></a></div>
    </section>
  </main>
</Layout>
