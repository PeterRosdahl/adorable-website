---
import SiteNavigation from '../components/SiteNavigation.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteMotion from '../components/SiteMotion.astro';
import '../styles/site.css';

// Self-hosted fonts (faster than Google Fonts)
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	swedishPath?: string;
	robots?: string;
}

const { title, description, ogImage = '/og-image.png', swedishPath = '/', robots = 'index, follow' } = Astro.props;
const normalizedPath = Astro.url.pathname !== '/' ? Astro.url.pathname.replace(/\/$/, '') : '/';
const canonicalURL = new URL(normalizedPath, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		
		<!-- Hreflang Tags -->
		<link rel="alternate" hreflang="sv" href={`https://adorable.se${swedishPath}`} />
		<link rel="alternate" hreflang="en" href={`https://adorable.se${normalizedPath}`} />
		<link rel="alternate" hreflang="x-default" href={`https://adorable.se${swedishPath}`} />
		
		<!-- Google Search Console Verification -->
		<meta name="google-site-verification" content="adcqv8TZQSccrHknOJPPtFdt18C5USmNfa1iBagVNaM" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, Astro.site)} />
		<meta property="og:locale" content="en_US" />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(ogImage, Astro.site)} />
		<meta property="twitter:creator" content="@PeterRosdahl" />
		
		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<!-- Umami Analytics (privacy-first, no cookies) -->
		<script defer src="https://cloud.umami.is/script.js" data-website-id="e5ec55d8-278e-4400-93c0-1d833882a91d"></script>
		
		<!-- Fonts loaded via @fontsource (self-hosted, no external requests) -->
		
		<!-- Structured Data -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "ProfessionalService",
				"name": "Adorable",
				"description": "AI consulting and Paid Social consulting services",
				"url": "https://adorable.se/en",
				"telephone": "+46708235787",
				"email": "peter@adorable.se",
				"image": "https://adorable.se/og-image.png",
				"logo": {
					"@type": "ImageObject",
					"url": "https://adorable.se/adorable-logo.png"
				},
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Stockholm",
					"addressCountry": "SE"
				},
				"founder": {
					"@type": "Person",
					"name": "Peter Rosdahl",
					"jobTitle": "Consultant - AI consulting and Paid Social",
					"url": "https://adorable.se/en/about",
					"sameAs": [
						"https://x.com/PeterRosdahl",
						"https://www.linkedin.com/in/peterrosdahl",
						"https://www.threads.net/@PeterRosdahl"
					]
				},
				"@id": "https://adorable.se/#business",
				"areaServed": {
					"@type": "Country",
					"name": "Sweden"
				},
				"makesOffer": [
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "AI consulting",
							"serviceType": "AI consulting"
						}
					},
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "Paid Social Marketing",
							"serviceType": "Paid Social Marketing"
						}
					}
				]
			}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteNavigation lang="en" alternatePath={swedishPath} />
		<div id="main-content" tabindex="-1"><slot /></div>
		<SiteFooter lang="en" />
		<SiteMotion />
	</body>
</html>
